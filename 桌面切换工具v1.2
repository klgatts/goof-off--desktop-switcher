    ExitApp()
}

; ============================================================
; 启动代码：读配置、注册快捷键、刷托盘菜单（都放最后，函数在上面）
; ============================================================
configFile  := A_ScriptDir "\桌面切换.ini"   ; 快捷键存在这个 ini 里
global lastDown := 0, armed := false, holdFired := false, sawUp := true   ; 按下+抬起判定状态
judgeMs := IniRead(configFile, "设置", "JudgeMs", 250)   ; 单击/双击判定时间，托盘可改，默认 250
if (judgeMs < 150 || judgeMs > 1000) {      ; 超范围就拉回 150~1000（填 1 会变成 150）
    judgeMs := Min(Max(judgeMs, 150), 1000)
    IniWrite(judgeMs, configFile, "设置", "JudgeMs")
}
workDesktop := IniRead(configFile, "设置", "WorkDesktop", 0)   ; 0=桌面1 是工作桌面，1=桌面2
if (workDesktop != 0 && workDesktop != 1)    ; 配置坏了就退回桌面1
    workDesktop := 0
global hiddenList := []                          ; 被隐藏窗口的记录（托盘「释放所有」兜底用）
global mutedForWork := false                     ; 因离开摸鱼而禁音（回摸鱼时解开）
global wakePending := 0                         ; 浏览器唤出后待唤醒（松手时处理）
autoMute := IniRead(configFile, "设置", "AutoMute", 1)   ; 离开摸鱼自动静音，默认开，托盘可关
if (autoMute != 0 && autoMute != 1)
    autoMute := 1
Q := Chr(34)                                  ; 英文双引号，拼带引号的命令时用
hotkeyName  := IniRead(configFile, "设置", "Hotkey", "LCtrl+Num*")  ; 默认 左Ctrl+小键盘*
; 老配置里存的可能是 "^NumpadMult" 这种机器码，顺手翻译成人话写回去
if RegExMatch(hotkeyName, "[<>^!#]") || InStr(hotkeyName, "Numpad") {
    hotkeyName := AhkToFriendly(hotkeyName)
    IniWrite(hotkeyName, configFile, "设置", "Hotkey")
}

autoStart := IniRead(configFile, "设置", "AutoStart", 0)   ; 开机自启，默认关，记在 ini 里
if (autoStart)   ; 开着自启的话顺手把注册表补上（防止被清理工具删掉）
    SetAutoStart(true)

; 注册快捷键（主键 + 抬起；ini 里存的不能用就退回默认的）
try {
    Hotkey(FriendlyToAhk(hotkeyName), ToggleAction, "On")
    Hotkey(FriendlyToAhk(hotkeyName) " Up", MainKeyUp, "On")
} catch {
    hotkeyName := "LCtrl+Num*"
    Hotkey(FriendlyToAhk(hotkeyName), ToggleAction, "On")
    Hotkey(FriendlyToAhk(hotkeyName) " Up", MainKeyUp, "On")
    IniWrite(hotkeyName, configFile, "设置", "Hotkey")
}

UpdateTrayMenu()

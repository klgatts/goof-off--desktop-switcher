#Requires AutoHotkey v2.0
#SingleInstance Force

; ============================================================
; 桌面切换工具 v1.2
;   单击：在 工作桌面 和 摸鱼桌面 之间来回切（另一个桌面没有会自动新建）
;   双击：切回工作桌面，再把默认浏览器切到第一个标签页
;   长按 350ms：完全隐藏当前窗口（任务栏也看不到），再长按一次放出来（静默）
;   智能静音：离开摸鱼时若摸鱼在放音视频会自动禁音，回摸鱼自动恢复
;             （不想要可在托盘「离开摸鱼自动静音」取消勾选）
;   托盘图标右键：改快捷键 / 执行速度延迟 / 设定工作桌面 / 开机启动 / 更多
;   快捷键说明：
;     - 支持鼠标中键、侧键（XButton1/XButton2），滚轮不行
;     - 修饰键区分左右（LCtrl/RCtrl/LAlt/RAlt/LShift/RShift/LWin/RWin）
;     - 触发方式：按住修饰键不放、连续按主键；或修饰键和主键一起按下都行
;   特别说明：本脚本已经把 DLL 塞进了自己身体里（下面那一大段
;             乱码就是它，base64 编码的），运行时会自动解到临时
;             文件夹再用，所以脚本目录不用单独放 DLL 文件。
; ============================================================

; ---------- 判定方案：按下 + 抬起（350 毫秒判定窗口） ----------
; 单击：按一下就松手 → 在 工作桌面/摸鱼桌面 之间切
; 双击：快速按两下 → 切回工作桌面 + 默认浏览器第一个标签
; 长按：按住不松 350ms → 隐藏当前窗口；再长按一次 → 放出来（静默，无提示）
; 静音：离开摸鱼桌面时，摸鱼焦点在放音视频会自动禁音，回摸鱼自动恢复
ToggleAction(*) {      ; 主键按下
    global lastDown, armed, holdFired, sawUp, judgeMs
    if !sawUp                          ; 上一次还没抬起 = 按住期间的自动重复，忽略
        return
    if (A_TickCount - lastDown < judgeMs) {   ; 松开后又快速按下 → 双击
        lastDown := A_TickCount
        sawUp := false
        armed := false
        SetTimer(DoSingleClick, 0)     ; 把挂着的单击取消
        SetTimer(CheckLongHold, 0)     ; 长按检查也取消
        DoDouble()                     ; 直接执行双击动作
        return
    }
    lastDown := A_TickCount
    sawUp := false
    armed := true
    holdFired := false
    SetTimer(CheckLongHold, -(judgeMs + 30))   ; 到点还没抬起 = 长按
}

; 主键抬起：松手了 → 不是长按，挂一个延迟单击（这期间再按就变双击）
MainKeyUp(*) {
    global sawUp, armed, holdFired, judgeMs, wakePending
    sawUp := true
    SetTimer(CheckLongHold, 0)
    if (holdFired && wakePending) {
        ; 唤出的是浏览器：显示到此为止，不再做任何鼠标动作/激活——
        ; 再多碰它一下反而会把刚唤出的 Chromium 弄瘫（实测过）。
        ; 已知遗留问题：Edge 隐藏再唤出后键盘输入会暂时失灵（双击/Ctrl+1 无效），
        ; 点一下屏幕可恢复，暂无自动修复方案，以后再看。
        wakePending := 0
        return
    }
    if !armed
        return
    armed := false
    if holdFired
        return
    SetTimer(DoSingleClick, -judgeMs)
}

; 长按检查：到点还没收到抬起 → 长按
CheckLongHold() {
    global armed, holdFired, hiddenList, wakePending
    if !armed || holdFired
        return
    holdFired := true
    armed := false
    ; 这次若是唤出（有藏着的窗口）且是浏览器 → 标记等松手再唤醒。
    ; 标记紧跟 holdFired 写入，MainKeyUp 无论何时抢跑都能看到，杜绝漏标。
    wakePending := (hiddenList.Length > 0) && IsBrowser(hiddenList[hiddenList.Length].hwnd)
    ToggleHide()                       ; 长按：隐藏当前窗口 / 唤出最近藏的那个
}

; 单击执行（延迟 judgeMs，期间再按会变成双击而取消）
DoSingleClick(*) {
    global lastDown, judgeMs
    if (A_TickCount - lastDown >= judgeMs)
        DoSingle()
}

; 单击动作：在 工作桌面 和 摸鱼桌面 之间来回切（另一个桌面没有就先建一个）
; 离开摸鱼去工作时，摸鱼焦点在放音视频 → 禁音（回摸鱼时解开）
DoSingle() {
    global workDesktop, mutedForWork, autoMute
    current := GetCurrentDesktop()
    if (current < 0)                   ; DLL 万一抽风返回负数，就啥也别干
        return
    if (autoMute && current != workDesktop) {
        ; 正从摸鱼去工作（自动静音开着）：摸鱼焦点是音视频 → 禁音（回摸鱼时恢复）
        try
            fw := WinGetID("A")
        catch
            fw := 0
        if (fw && IsMediaApp(fw)) {
            SoundSetMute 1
            mutedForWork := true
        }
    } else if (autoMute && mutedForWork) {
        ; 正从工作回摸鱼：之前自动禁过音 → 解开
        SoundSetMute 0
        mutedForWork := false
    }
    if (current = 0) && (GetDesktopCount() < 2)
        CreateDesktop()
    GoToDesktop(current = 1 ? 0 : 1)
}

; 双击动作：如果在摸鱼桌面，先切回工作桌面，再把默认浏览器切到第一个标签
; 焦点是音视频 → 直接禁音（从摸鱼回工作的记标记，回摸鱼时自动解开）
DoDouble() {
    global workDesktop, mutedForWork, autoMute
    try
        fw := WinGetID("A")
    catch
        fw := 0
    if (fw && IsMediaApp(fw)) {
        SoundSetMute 1                       ; 焦点在放音视频 → 直接静音
        if (autoMute && GetCurrentDesktop() != workDesktop)
            mutedForWork := true             ; 从摸鱼回工作的记标记，回摸鱼自动解开
    }
    current := GetCurrentDesktop()
    if (current != workDesktop) {
        GoToDesktop(workDesktop)
        Sleep(300)
    }
    SwitchToFirstTab()
}

; 长按隐藏/恢复窗口：藏一个、再长按放回来（正常永远是这个窗口在循环，静默无提示）
; 恢复时保持藏之前的样子：最大化的还是最大化，普通的就是普通状态
; 藏的是音视频窗口 → 顺手禁音；放出来时如果藏它时禁音了 → 解开禁音
; 只有异常（该放的没放出来）时才会有残留，托盘「释放所有」就是兜底用的
ToggleHide() {
    global hiddenList, wakePending
    if (hiddenList.Length = 0) {       ; 现在没藏 → 把焦点窗口藏起来
        try
            h := WinGetID("A")
        catch
            return                     ; 焦点在桌面/没有活动窗口 → 没啥可藏，忽略
        if (h = 0)                     ; 还是没拿到就拉倒
            return
        wasMax := WinGetMinMax(h)      ; 记一下是不是最大化（1 = 最大化）
        muted  := IsMediaApp(h)        ; 藏的是音视频 → 顺手禁音
        if (muted)
            SoundSetMute 1
        hiddenList.Push({hwnd: h, wasMax: wasMax, muted: muted})
        wakePending := 0
        WinHide(h)                     ; 完全隐藏（从屏幕和任务栏都消失）
        return
    }
    ; 有藏着的 → 放出最近藏的那个，保持原来的样子
    item := hiddenList.Pop()
    h := item.hwnd
    WinShow(h)                         ; 立即显示（跟手）
    if (item.wasMax = 1)               ; 藏之前是最大化 → 恢复成最大化
        WinMaximize(h)
    else
        WinRestore(h)                  ; 普通窗口 → 恢复普通状态
    if (item.muted)                    ; 藏它时禁音了 → 解开禁音
        SoundSetMute 0
    if (wakePending) {
        ; 浏览器：显示到此为止，不再多碰——会把刚唤出的 Chromium 又弄瘫（实测过）
        return
    }
    WinActivate(h)
    if !WinWaitActive(h, , 1)
        WinActivate(h)
}

; 浏览器/播放器进程名单（摸鱼放音视频的基本就这些，按进程名粗判定，够用）
browserList := "msedge.exe chrome.exe firefox.exe opera.exe brave.exe vivaldi.exe 360se.exe 360chrome.exe qqbrowser.exe sogouexplorer.exe maxthon.exe"
mediaList   := "potplayer.exe vlc.exe mpv.exe mpc-hc.exe mpc-be.exe wmplayer.exe kmplayer.exe qqplayer.exe 网易云音乐.exe cloudmusic.exe kuwo.exe kugou.exe qqmusic.exe foobar2000.exe bilibili.exe douyin.exe"

; 判断窗口是不是浏览器：标记唤出的窗口类型（浏览器有已知的唤出后键盘失灵问题）
IsBrowser(h) {
    global browserList
    p := WinGetProcessName(h)
    return InStr(browserList, p) != 0
}

; 判断窗口是不是音视频类程序（浏览器/播放器/音乐客户端）
IsMediaApp(h) {
    global browserList, mediaList
    p := WinGetProcessName(h)
    return InStr(browserList " " mediaList, p) != 0
}

; 设定工作桌面（0 = 桌面1，1 = 桌面2），另一个自动就是摸鱼桌面，记进 ini
SetWorkDesktop(n) {
    global workDesktop, configFile
    workDesktop := n
    IniWrite(n, configFile, "设置", "WorkDesktop")
    UpdateTrayMenu()
    TrayTip("桌面切换", "工作桌面已设为 桌面" (n + 1) "，另一个是摸鱼桌面")
}

; 兜底按钮：正常长按一直是"藏一个→放一个"，不该有残留；
; 万一哪个窗口没放出来（异常），用这个一键全部恢复
ReleaseAllHidden(*) {
    global hiddenList
    n := 0
    while (hiddenList.Length > 0) {
        item := hiddenList.Pop()
        if !WinExist("ahk_id " item.hwnd)
            continue                   ; 窗口已经不在了（被关了）就跳过
        WinShow(item.hwnd)
        if (item.wasMax = 1)
            WinMaximize(item.hwnd)
        else
            WinRestore(item.hwnd)
        if (item.muted)                ; 藏它时禁音了 → 一起解开
            SoundSetMute 0
        n += 1
    }
    TrayTip("桌面切换", "已释放 " n " 个隐藏窗口")
}

; 托盘开关：离开摸鱼自动静音（回到工作桌面时自动禁音），可自行开关，记进 ini
ToggleAutoMute(*) {
    global autoMute, mutedForWork, configFile
    autoMute := !autoMute
    if (!autoMute && mutedForWork) {
        ; 关掉自动静音：把之前自动禁的音解开，免得一直静音
        SoundSetMute 0
        mutedForWork := false
    }
    IniWrite(autoMute, configFile, "设置", "AutoMute")
    UpdateTrayMenu()
    TrayTip("桌面切换", autoMute ? "已开启：离开摸鱼自动静音" : "已关闭：离开摸鱼自动静音")
}

; ---------- 打开/聚焦默认浏览器，切到第一个标签 ----------
SwitchToFirstTab() {
    global Q
    exe := GetDefaultBrowserExe()
    if (exe = "") {
        ; 认不出默认浏览器就退回用 Edge
        exe  := "C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"
        proc := "ahk_exe msedge.exe"
        procName := "msedge.exe"
    } else {
        SplitPath(exe, &procName)
        proc := "ahk_exe " procName
    }
    ; 浏览器没开就打开，最多等 10 秒
    if !WinExist(proc) {
        Run(Q exe Q)
        WinWait(proc, , 10)
        if !WinExist(proc)
            return   ; 等了半天还是没窗口，拉倒
    }
    ; 激活浏览器窗口，按 Ctrl+1 切到第一个标签
    ; （Ctrl+1 是所有主流浏览器都认的"切到第一个标签"快捷键）
    ; 优先用当前活动窗口：隐藏/唤出后它就是那个刚唤出的浏览器，别认错到别的窗口
    hw := 0
    try
        ah := WinGetID("A")
    catch
        ah := 0
    if (ah && WinGetProcessName(ah) = procName)
        hw := ah
    else
        hw := WinGetID(proc)
    if (hw)
        RobustActivate(hw)             ; 强制激活（Edge 刚隐藏/唤出后必须靠它）
    else
        WinActivate(proc)
    WinWaitActive(proc, , 3)
    SendInput("^1")
}

; 强制激活一个窗口：普通激活不行就模拟按一下 Alt 解除系统"前台锁"，再激活
; （Edge 这类浏览器刚隐藏/唤出后特别容易激活失败，双击切标签前必须靠它）
RobustActivate(hwnd) {
    if WinGetMinMax(hwnd) = -1         ; 最小化的才还原（别把最大化的弄成普通）
        WinRestore(hwnd)
    if WinActive(hwnd)
        return
    WinActivate(hwnd)
    if !WinWaitActive(hwnd, , 0.8) {
        SendEvent("{Alt down}{Alt up}")   ; 经典技巧：按一下 Alt 解锁前台
        WinActivate(hwnd)
        WinWaitActive(hwnd, , 0.8)
    }
}

; 去注册表查系统默认浏览器是哪个（按 http 链接的关联来找）
GetDefaultBrowserExe() {
    global Q
    ; 先拿默认浏览器的"代号"（比如 ChromeHTML / MSEdgeHTM / FirefoxURL-xxx）
    progId := RegRead("HKCU\Software\Microsoft\Windows\Shell\Associations\UrlAssociations\http\UserChoice", "ProgId", "")
    if (progId = "")
        return ""
    ; 用代号找它的启动命令，系统级找不到再翻用户级的
    cmd := RegRead("HKLM\Software\Classes\" progId "\shell\open\command", "", "")
    if (cmd = "")
        cmd := RegRead("HKCU\Software\Classes\" progId "\shell\open\command", "", "")
    if (cmd = "")
        return ""
    ; 启动命令一般是 "C:\...\xxx.exe" 加一堆参数，把带引号的 exe 路径抠出来
    start := InStr(cmd, Q) + 1
    end   := InStr(cmd, Q, , start)
    if (end > start) {
        exe := SubStr(cmd, start, end - start)
        ; 顺手确认一下：路径真实存在，而且确实是个 .exe
        if FileExist(exe) && (SubStr(exe, -4) = ".exe")
            return exe
    }
    return ""
}

; ---------- 执行速度延迟：单击/双击的判定时间，自己填数字（范围 150~1000 毫秒） ----------
ModifyDelay(*) {
    global judgeMs, configFile
    dlg := Gui("+AlwaysOnTop +ToolWindow", "执行速度延迟")
    dlg.Add("Text", "w300", "单击/双击的判定时间（毫秒），改完立即生效：")
    dlg.Add("Text", "w300", "调大 = 双击更好按，但单击响应稍慢；调小 = 单击更跟手")
    dlg.Add("Text", "w300", "范围 150~1000 毫秒（填 1 会自动变成 150）")
    edit := dlg.Add("Edit", "w300", judgeMs)
    dlg.Add("Button", "default w80 xm", "确定").OnEvent("Click", (*) => SubmitDelay(dlg, edit))
    dlg.Add("Button", "w80 x+40", "取消").OnEvent("Click", (*) => dlg.Destroy())
    dlg.Show()
}

SubmitDelay(dlg, edit) {
    global judgeMs, configFile
    try
        v := Integer(edit.Text)        ; 填的不是数字就当 0 处理
    catch
        v := 0
    if (v < 150)                       ; 最低 150 毫秒
        v := 150
    if (v > 1000)                      ; 最高 1000 毫秒
        v := 1000
    dlg.Destroy()
    judgeMs := v
    IniWrite(v, configFile, "设置", "JudgeMs")   ; 记进 ini，下次启动还记得
    UpdateTrayMenu()
    TrayTip("桌面切换", "执行速度延迟已设为 " v " 毫秒")
}

; ---------- 开机自启 ----------
SetAutoStart(on) {   ; 往注册表 Run 键写/删一条：登录时用当前这个 AHK 解释器跑本脚本
    if (on)
        RegWrite('"' A_AhkPath '" "' A_ScriptFullPath '"', "REG_SZ", "HKCU\Software\Microsoft\Windows\CurrentVersion\Run", "桌面切换")
    else
        try
            RegDelete("HKCU\Software\Microsoft\Windows\CurrentVersion\Run", "桌面切换")
}

ToggleAutoStart(*) {   ; 点一下就在"开机自启"和"不开机自启"之间切换，状态记进 ini
    global autoStart, configFile
    autoStart := !autoStart
    SetAutoStart(autoStart)
    IniWrite(autoStart, configFile, "设置", "AutoStart")
    UpdateTrayMenu()
    TrayTip("桌面切换", autoStart ? "已开启开机启动" : "已关闭开机启动")
}

; ---------- 托盘菜单：改快捷键 / 执行速度 / 开机启动 / 说明 / 退出 ----------
UpdateTrayMenu() {
    global hotkeyName, autoStart, judgeMs, workDesktop, autoMute
    A_TrayMenu.Delete()
    ; ---- 常用：快捷键和速度 ----
    A_TrayMenu.Add("修改快捷键（" hotkeyName "）", ModifyHotkey)
    A_TrayMenu.Add("执行速度延迟（" judgeMs "毫秒）", ModifyDelay)
    A_TrayMenu.Add()
    ; ---- 桌面与声音 ----
    wm := Menu()                        ; 设定工作桌面：子菜单选 桌面1/桌面2
    wm.Add("桌面1 是工作桌面", (*) => SetWorkDesktop(0))
    wm.Add("桌面2 是工作桌面", (*) => SetWorkDesktop(1))
    A_TrayMenu.Add("设定工作桌面（当前：桌面" (workDesktop + 1) "）", wm)
    A_TrayMenu.Add("离开摸鱼自动静音", ToggleAutoMute)
    if (autoMute)
        A_TrayMenu.Check("离开摸鱼自动静音")
    else
        A_TrayMenu.Uncheck("离开摸鱼自动静音")
    A_TrayMenu.Add()
    ; ---- 系统 ----
    A_TrayMenu.Add("开机启动", ToggleAutoStart)
    if (autoStart)                      ; 勾上就代表开着开机自启
        A_TrayMenu.Check("开机启动")
    else
        A_TrayMenu.Uncheck("开机启动")
    ; 兜底的和说明收进「更多」子菜单，主菜单保持清爽
    more := Menu()
    more.Add("释放所有隐藏窗口", ReleaseAllHidden)
    more.Add()
    more.Add("使用说明", ShowHelp)
    A_TrayMenu.Add("更多", more)
    A_TrayMenu.Add()
    A_TrayMenu.Add("退出", (*) => ExitApp())
}

; ---------- 使用说明：弹框介绍一下单击/双击干嘛用的 ----------
ShowHelp(*) {
    global hotkeyName, judgeMs, workDesktop
    ; 小窗说明：白底 + 蓝色标题 + 分隔线，看着清爽
    helpGui := Gui("+AlwaysOnTop", "桌面切换 - 使用说明")
    helpGui.BackColor := "FFFFFF"
    helpGui.SetFont("s16 Bold", "微软雅黑")
    helpGui.Add("Text", "w450 Center c2B579A0", "桌面切换工具")
    helpGui.SetFont("s9", "微软雅黑")
    helpGui.Add("Text", "w450 Center c808080",
        "快捷键：" hotkeyName "　·　工作桌面：桌面" (workDesktop + 1) "　·　判定 " judgeMs "ms")
    helpGui.SetFont("s10", "微软雅黑")
    helpGui.Add("Text", "w450 h1 BackgroundD0D0D0")
    helpGui.Add("Text", "w450", "• 单击：在工作 / 摸鱼桌面之间来回切换" .
        "`n      离开摸鱼时，若摸鱼在放音视频会自动静音，回摸鱼自动恢复" .
        "`n      （不想要自动静音：托盘「离开摸鱼自动静音」取消勾选）" .
        "`n`n• 双击：切回工作桌面，默认浏览器切到第一个标签" .
        "`n      若焦点在放音视频会顺手静音" .
        "`n`n• 长按：隐藏当前窗口（藏的是音视频会静音），再长按放出来（恢复声音）" .
        "`n`n• 释放所有隐藏窗口：异常时一键恢复所有没放出来的窗口（托盘 更多）")
    helpGui.Add("Text", "w450 h1 BackgroundD0D0D0")
    helpGui.SetFont("s9 c808080")
    helpGui.Add("Text", "w450 Center", "以上设置都会自动记住，重启后依然有效")
    helpGui.Add("Button", "default x195 w60", "知道了").OnEvent("Click", (*) => helpGui.Destroy())
    helpGui.Show()
}

; ---------- 改快捷键：直接按组合键录制，Esc 取消 ----------
ModifyHotkey(*) {
    global hotkeyName, configFile

    ; 弹个小窗口提示按什么键
    capGui := Gui("+AlwaysOnTop +ToolWindow", "修改快捷键")
    capGui.Add("Text", "w340", "按下新的快捷键组合（可含鼠标中键/侧键，Esc 取消）")
    capGui.Add("Text", , "当前：" hotkeyName)
    capGui.Show()

    ; 用输入钩子等按键：10 秒超时，按 Esc 直接取消
    ih := InputHook("T10", "{Esc}")
    ih.KeyOpt("{All}", "E")              ; 任意键按下去就算结束
    ih.KeyOpt("{LControl}{RControl}{LShift}{RShift}{LAlt}{RAlt}{LWin}{RWin}", "-E")  ; 但单独按修饰键不算
    ih.Start()
    ih.Wait()
    capGui.Destroy()

    if (ih.EndReason = "Timeout") {
        MsgBox("等待按键超时，快捷键未修改。", "桌面切换", "Iconi")
        return
    }
    if (ih.EndKey = "Escape")
        return
    if (ih.EndKey = "WheelUp" || ih.EndKey = "WheelDown") {
        MsgBox("不支持滚轮键，请用键盘键或鼠标中键/侧键。", "桌面切换", "Iconi")
        return
    }

    ; 新快捷键 = 当时按住的修饰键（人话，区分左右）+ 主键（人话）
    new := ModsToFriendly(ih.EndMods) . AhkKeyToFriendly(ih.EndKey)
    if (new = hotkeyName)
        return   ; 跟原来一样就没必要改

    ; 先注册新的（主键 + 抬起），成功才关掉旧的
    old := hotkeyName
    try {
        Hotkey(FriendlyToAhk(new), ToggleAction, "On")
        Hotkey(FriendlyToAhk(new) " Up", MainKeyUp, "On")
    } catch {
        MsgBox("无法注册该按键：" new, "桌面切换", "Iconx")
        return
    }
    Hotkey(FriendlyToAhk(old), "Off")
    Hotkey(FriendlyToAhk(old) " Up", "Off")
    hotkeyName := new
    IniWrite(new, configFile, "设置", "Hotkey")   ; 写进 ini（人话，下次启动还记得）
    UpdateTrayMenu()
    TrayTip("桌面切换", "快捷键已修改为：" new)
}

; ---------- 快捷键名字：人话 ↔ 机器码 转换 ----------
; 人话例子：LCtrl+Num* / RCtrl+XButton2 / MButton / LWin+F5
; 机器码例子：<^NumpadMult / >^XButton2 / MButton / <#F5

; 把一串按键名开头的修饰键符号抠出来（<^、>!、^ 这种），返回符号串
ExtractMods(raw) {
    mods := ""
    pos := 1
    while (pos <= StrLen(raw)) {
        ch := SubStr(raw, pos, 1)
        if (ch = "<" || ch = ">") {     ; 带尖括号 = 左右修饰键，一次读两个字符
            mods .= SubStr(raw, pos, 2)
            pos += 2
        } else if (ch = "^" || ch = "!" || ch = "+" || ch = "#") {
            mods .= ch
            pos += 1
        } else
            break
    }
    return mods
}

ModsToFriendly(mods) {   ; 修饰键符号串（InputHook 给的格式）→ 人话（区分左右）
    lookup := Map("<^","LCtrl", ">^","RCtrl", "<!","LAlt", ">!","RAlt", "<+","LShift", ">+","RShift", "<#","LWin", ">#","RWin", "^","Ctrl", "!","Alt", "+","Shift", "#","Win")
    got := Map("LCtrl",0,"RCtrl",0,"LAlt",0,"RAlt",0,"LShift",0,"RShift",0,"LWin",0,"RWin",0,"Ctrl",0,"Alt",0,"Shift",0,"Win",0)
    pos := 1
    len := StrLen(mods)
    while (pos <= len) {
        ch := SubStr(mods, pos, 1)
        if (ch = "<" || ch = ">") {
            sym := SubStr(mods, pos, 2)
            pos += 2
        } else {
            sym := ch
            pos += 1
        }
        name := lookup.Get(sym, "")
        if (name != "")
            got[name] := 1
    }
    ; 按 Ctrl、Alt、Shift、Win 的顺序拼出来，左右在前
    out := ""
    for name in ["LCtrl","RCtrl","LAlt","RAlt","LShift","RShift","LWin","RWin","Ctrl","Alt","Shift","Win"]
        if got[name]
            out .= name "+"
    return out
}

AhkKeyToFriendly(key) {   ; AHK 键名 → 人话（主要把小键盘几个键翻译一下）
    m := Map("NumpadMult","Num*", "NumpadDiv","Num/", "NumpadAdd","Num+", "NumpadSub","Num-", "NumpadDot","Num.", "Numpad0","Num0","Numpad1","Num1","Numpad2","Num2","Numpad3","Num3","Numpad4","Num4","Numpad5","Num5","Numpad6","Num6","Numpad7","Num7","Numpad8","Num8","Numpad9","Num9", "Escape","Esc")
    return m.Get(key, key)
}

FriendlyKeyToAhk(key) {   ; 人话键名 → AHK 键名（跟上面反过来）
    m := Map("Num*","NumpadMult", "Num/","NumpadDiv", "Num+","NumpadAdd", "Num-","NumpadSub", "Num.","NumpadDot", "Num0","Numpad0","Num1","Numpad1","Num2","Numpad2","Num3","Numpad3","Num4","Numpad4","Num5","Numpad5","Num6","Numpad6","Num7","Numpad7","Num8","Numpad8","Num9","Numpad9", "Esc","Escape")
    return m.Get(key, key)
}

FriendlyToAhk(friendly) {   ; 人话 "LCtrl+Num*" → 机器码 "<^NumpadMult"，注册快捷键时用
    modMap := Map("LCtrl","<^", "RCtrl",">^", "Ctrl","^", "LAlt","<!", "RAlt",">!", "Alt","!", "LShift","<+", "RShift",">+", "Shift","+", "LWin","<#", "RWin",">#", "Win","#")
    ahk := ""
    key := ""
    started := false
    ; 主键可能本身就带 +（比如小键盘加号 Num+），所以不能全按 + 拆
    for part in StrSplit(friendly, "+") {
        if (!started && modMap.Has(part)) {
            ahk .= modMap[part]     ; 是修饰键就转成机器码符号
        } else {
            started := true         ; 从第一个不是修饰键的段开始，剩下的都算主键
            key .= (key = "" ? "" : "+") . part
        }
    }
    return ahk . FriendlyKeyToAhk(key)
}

AhkToFriendly(ahkName) {   ; 机器码 "^NumpadMult" → 人话 "Ctrl+Num*"，给老配置搬家用
    mods := ExtractMods(ahkName)
    return ModsToFriendly(mods) . AhkKeyToFriendly(SubStr(ahkName, StrLen(mods) + 1))
}

LoadEmbeddedDll() {
    global dllPath, embeddedDll, b64
    ; 临时文件夹里已经有这 DLL 且能直接加载 → 直接用，省得再解码
    if FileExist(embeddedDll) {
        if DllCall("LoadLibrary", "Str", embeddedDll, "Ptr") {
            dllPath := embeddedDll
            return true
        }
    }
    ; 先问系统：这段 base64 解出来占多大
    size := 0
    DllCall("Crypt32.dll\CryptStringToBinaryW", "Ptr", StrPtr(b64), "UInt", StrLen(b64), "UInt", 1, "Ptr", 0, "UInt*", &size, "Ptr", 0, "Ptr", 0)
    if (size = 0)
        return false
    ; 按大小申请内存，把 base64 真正解码成二进制
    buf := Buffer(size)
    if !DllCall("Crypt32.dll\CryptStringToBinaryW", "Ptr", StrPtr(b64), "UInt", StrLen(b64), "UInt", 1, "Ptr", buf, "UInt*", &size, "Ptr", 0, "Ptr", 0)
        return false
    ; 写成 .dll 文件再加载（Windows 只能从文件路径加载 DLL）
    try {
        f := FileOpen(embeddedDll, "w")
        f.RawWrite(buf, size)
        f.Close()
    } catch
        return false
    if !DllCall("LoadLibrary", "Str", embeddedDll, "Ptr")
        return false
    dllPath := embeddedDll
    return true
}

; ---------- 跟 DLL 打交道的几个小函数 ----------
GetCurrentDesktop() {   ; 现在在第几个桌面（0 = 桌面1，1 = 桌面2）
    global dllPath
    return DllCall(dllPath "\GetCurrentDesktopNumber", "Int")
}
GetDesktopCount() {     ; 一共开了几个桌面
    global dllPath
    return DllCall(dllPath "\GetDesktopCount", "Int")
}
CreateDesktop() {       ; 新建一个桌面（Win11 才支持）
    global dllPath
    DllCall(dllPath "\CreateDesktop", "Int")
}
GoToDesktop(n) {        ; 切到第 n 个桌面
    global dllPath
    DllCall(dllPath "\GoToDesktopNumber", "Int", n, "Int")
}

